<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="48dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/serie_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.JBacc.Title"
        android:textSize="26sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/matieres_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/serie_title"
        android:layout_marginTop="32dp"
        android:layout_above="@+id/btn_retour"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_retour"
        style="@style/Widget.JBacc.Button.Retour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Retour"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true" />

</RelativeLayout>
