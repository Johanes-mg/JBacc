<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.JBacc.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="backgroundTint">@color/jb_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.JBacc.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="backgroundTint">@color/jb_secondary</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.JBacc.Button.Retour" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="strokeColor">@color/jb_danger</item>
        <item name="android:textColor">@color/jb_danger</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/jb_danger</item>
    </style>

    <style name="Widget.JBacc.Button.Matiere" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>
        <item name="backgroundTint">@color/jb_matiere</item>
        <item name="android:textColor">@color/jb_matiere_text</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">1dp</item>
    </style>

    <style name="Widget.JBacc.Button.Fichier" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="backgroundTint">@color/jb_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.JBacc.Title" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/jb_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.JBacc.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/jb_text_secondary</item>
    </style>

    <style name="TextAppearance.JBacc.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/jb_text_primary</item>
    </style>
</resources>
